            {
              "type": "added",
              "text": "Every second spent in the forgotten temple has a 0.01% chance to instantly kill you"
            },
            {
              "group": "Gaia's Blessing Potion",
              "changes": [
                {
                  "type": "added",
                  "text": "Has been unlocked! It is considered a special item",
                  "details": [
                    "Heals you instantly 20% of your max health",
                    "Grants 25% defense for 10 seconds",
                    "Grants 30% movement speed for 15 seconds",
                    "Grants 50% stamina regeneration for 15 seconds",
                    "Heals you 20% max health over 10 seconds"
                  ]
                },
                {
                  "type": "added",
                  "text": "Can be obtained completing the Coffer quest in the Guttering Hollows"
                },
                {
                  "type": "added",
                  "text": "Does not have cooldown"
                }
              ]
            },
            {
              "group": "Performance changes",
              "changes": [
                {
                  "type": "changed",
                  "text": "Items merge radius is increased from 2 to 6"
                },
                {
                  "type": "changed",
                  "text": "Items despawn in 180 seconds"
                },
                {
                  "type": "changed",
                  "text": "Items in the Guttering Hollows despawn in 90 seconds"
                }
              ]
            }
          ]
        }
      ],
